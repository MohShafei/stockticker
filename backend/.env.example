# Copy to .env (never commit .env)
PORT=3000
# Free key from https://finnhub.io — US realtime. Empty = Yahoo fallback.
FINNHUB_KEY=
# Free key from https://twelvedata.com (800 req/day) — full symbol listings
# for UK/EU/Gulf/EGX + realtime upgrade path. Empty = curated fallback lists.
# Listings are cached 24h server-side, so ~10 calls/day are used.
# Hot symbols pre-warmed in background (comma separated)
HOT_SYMBOLS=AAPL,MSFT,HSBA.L,2222.SR,EMAAR.AE,COMI.CA,EURUSD=X,BTCUSDT
HOT_REFRESH_MS=60000
TTL_CRYPTO_MS=30000
TTL_US_MS=60000
TTL_INTL_MS=90000
